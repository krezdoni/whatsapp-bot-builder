STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PRICE_ID=price_your_price_id_here
NEXT_PUBLIC_URL=http://localhost:3000

# ── LinkedIn (AuthoredUp) ───────────────────────────────────────────────────
# Get your key: authoredup.com → Account → Generate API key
AUTHOREDUP_API_KEY=your_authoredup_key_here
# Optional override if AuthoredUp changes their base URL
AUTHOREDUP_API_BASE=https://api.authoredup.com

# ── Instagram + X / Twitter (Zernio) ───────────────────────────────────────
# Your existing Zernio / Getlate key covers both platforms
ZERNIO_API_KEY=sk_your_zernio_key_here
ZERNIO_API_BASE=https://zernio.com/api

# ── Substack ────────────────────────────────────────────────────────────────
# Your publication subdomain — e.g. "nicco" from nicco.substack.com
SUBSTACK_PUBLICATION=yourpublication
# Optional: paste your connect.sid cookie value to unlock open rates & clicks
# Get it: browser DevTools → Application → Cookies → substack.com → connect.sid
# (Substack uses Express.js so the cookie is named connect.sid, not substack.sid)
SUBSTACK_SESSION_COOKIE=
