# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://health_user:changeme@localhost:5432/health_db

# ── Encryption ────────────────────────────────────────────────────────────────
# 32-byte Fernet key (base64). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-fernet-key-here

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Local LLM (vLLM on Hetzner GPU) ──────────────────────────────────────────
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=Med42-70B
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3

# ── Messaging: Threema Gateway ────────────────────────────────────────────────
THREEMA_GATEWAY_ID=*YOUR_ID
THREEMA_GATEWAY_SECRET=your-threema-secret
THREEMA_PRIVATE_KEY=your-threema-private-key

# ── Messaging: WhatsApp via Sinch ─────────────────────────────────────────────
SINCH_APP_ID=your-sinch-app-id
SINCH_APP_SECRET=your-sinch-app-secret
SINCH_WHATSAPP_NUMBER=+4900000000000

# ── FHIR: Sundhedsjournalen (Denmark) ─────────────────────────────────────────
MITID_CLIENT_ID=your-mitid-client-id
MITID_CLIENT_SECRET=your-mitid-client-secret
MITID_REDIRECT_URI=https://your-domain.eu/auth/mitid/callback
SUNDHEDSJOURNALEN_FHIR_URL=https://api.sundhedsjournalen.dk/fhir/R4

# ── FHIR: gematik ePA (Germany, Phase 3) ─────────────────────────────────────
GEMATIK_IDP_URL=https://idp.epa.gematik.de
GEMATIK_CLIENT_ID=your-gematik-client-id
EPA_FHIR_URL=https://epa.gematik.de/fhir/R4

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
# If unset, falls back to in-memory dict (dev only — not safe for multi-process)
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
